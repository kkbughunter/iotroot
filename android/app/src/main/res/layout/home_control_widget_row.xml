    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:id="@+id/widget_slot_1"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginEnd="1dp"
        android:layout_weight="1" />

    <FrameLayout
